// The knife stealth kill (v36), as a player does it: in Riverwood by day, CJ with the knife, a Whiterun guard placed
// 1.05 m ahead with his back to him, the guard, CJ and Skyrim's hidden player recorded at 30 Hz; CJ crouches, holds the
// right button and clicks the left one; paused on the grab and on the stab for a shot from the side, and once from
// behind CJ. scripts/skytest.ps1 run scenarios/stealth-kill.json (scenarios/README.md). One kill a run, from a fresh
// session (skytest stop, then session): a kill is a crime, and a guard placed after one comes out fighting CJ, whom a
// stealth kill rightly refuses, as San Andreas does.
//
// The limits: the guard grabbed within 1.3 m and dead; Skyrim's stagger walks him forward and San Andreas's hold (a
// metre behind, 5 cm a step) takes CJ along, so CJ's path stays under 120 units (no teleport: the playtest's was 100 m);
// the hidden player never 3 m from CJ. Measured on the test desktop (13 November 2026): CJ 51 to 107 units on.
{
  "name": "stealth-kill",
  "steps": [
    { "label": "to Riverwood", "cmd": "console", "command": "coc Riverwood" },
    { "cmd": "wait", "seconds": 8 },
    { "label": "Skyrim's player healthy", "cmd": "console", "command": "player.restoreav health 10000" },
    { "label": "in Riverwood", "cmd": "state", "ref": "player", "expect": ["cell == Riverwood", "dead == false"] },
    { "label": "Skyrim takes the player", "cmd": "asr.cj", "on": false, "expect": "cj == false" },
    { "label": "CJ takes it there", "cmd": "asr.cj", "expect": "cj == true" },
    { "label": "San Andreas builds CJ's ground", "cmd": "wait", "seconds": 2 },
    { "label": "day", "cmd": "scene", "presets": "day clear" },
    { "label": "the knife", "cmd": "asr.give", "weapon": 4, "ammo": 1, "expect": "weapon == 4" },

    { "label": "a guard 1.05 m ahead, his back to CJ", "cmd": "asr.victim", "meters": 1.05 },
    { "cmd": "wait", "seconds": 1 },
    { "label": "record the guard, CJ and the hidden player", "cmd": "record", "action": "start", "refs": "asr.victim:,asr.cj:,player",
      "leader": "asr.cj:", "hz": 30, "name": "kill", "near": 1000 },
    { "label": "crouched, the knife raised, the grab", "cmd": "asr.stealth", "until": "grab", "crouch": true,
      "expect": ["sneaking == true", "cjToVictim < 1.3", "health > 0"] },
    "pause",
    { "cmd": "screenshot", "name": "grab", "camera": "orbit asr.victim: yaw=90 distance=280 pitch=10 height=70" },
    "resume",
    { "label": "the stab: the guard dies into a ragdoll", "cmd": "asr.stealth", "until": "stab",
      "expect": ["cjMoved < 120", "playerFromCj < 210"] },
    "pause",
    { "cmd": "screenshot", "name": "stab", "camera": "orbit asr.victim: yaw=90 distance=280 pitch=10 height=70" },
    { "cmd": "screenshot", "name": "stab-behind", "camera": "orbit asr.cj: yaw=0 distance=300 pitch=15 height=80" },
    "resume",
    { "label": "the guard dead and let go", "cmd": "asr.stealth", "until": "over",
      "expect": ["victimDead == true", "cjMoved < 120", "playerFromCj < 210"] },
    { "cmd": "screenshot", "name": "after", "camera": "orbit asr.victim: yaw=90 distance=300 pitch=15 height=70" },
    { "label": "the tracks: no teleport, the hidden player by CJ", "cmd": "record", "action": "stop",
      "expect": ["tracks.1.pathLength < 130", "tracks.2.leader.max < 210"] },
    { "label": "the stars gone", "cmd": "asr.cheat", "code": "ASNAEB" },
    { "label": "the scene as it was", "cmd": "scene", "presets": "restore" }
  ]
}
