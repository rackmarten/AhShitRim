// Skyrim's look sensitivity and CJ's camera (look_sensitivity.h): each slider's bottom, middle and top give CJ's camera a
// quarter of San Andreas's own speed, the speed itself and four times it, for the mouse and the pad's right stick; and
// the one-time move of both sliders to their middle. The input is the kit's mouse and stick commands (Skyrim's own input
// events through its input queue, so the look counts go through AhShitRim's input sink as a real mouse's and pad's do);
// the sliders are set and read with asr.look, which also measures how far CJ's camera turned (San Andreas's pose). In
// Riverwood, CJ standing. scripts/skytest.ps1 run scenarios/look-sensitivity.json (scenarios/README.md). A test
// session's SkyrimPrefs.ini is its own (the player's comes back on stop), and so is its AhShitRim.ini's LookReset.
//
// The limits: the scales are the formula's (0.25, 1, 4 to 0.001); the turns measured against the middle's within 15 %
// for the mouse (80 counts over 4 frames; San Andreas turns about 0.31 degrees a count at the middle, so the top's
// four times stays under half a turn) and 20 % for the
// stick (half right for 0.4 s, so a frame's timing more or less shows), set from runs on the test desktop (values in the pull
// request). The move to the middle: from Skyrim's own defaults (0.0125, 0.6667) to 0.0300 and 1.0000, recorded as
// LookReset=1 and logged.
{
  "name": "look-sensitivity",
  "steps": [
    { "label": "nothing held from before", "cmd": "input", "release": true },
    { "label": "to Riverwood", "cmd": "console", "command": "coc Riverwood" },
    { "cmd": "wait", "seconds": 8 },
    { "label": "Skyrim's player healthy", "cmd": "console", "command": "player.restoreav health 10000" },
    { "label": "Skyrim's gamepad on, as a pad player has it", "cmd": "console", "command": "setini \"bGamepadEnable:Controls\" 1" },
    { "label": "Skyrim takes the player", "cmd": "asr.cj", "on": false, "expect": "cj == false" },
    { "label": "CJ takes it", "cmd": "asr.cj", "expect": "cj == true" },
    { "label": "San Andreas builds CJ's ground", "cmd": "wait", "seconds": 3 },
    { "label": "the sliders' ends, read from Skyrim", "cmd": "asr.look",
      "expect": ["mouseMin ~ 0.01 +- 0.0001", "mouseMax ~ 0.05 +- 0.0001", "padMin ~ 0.4445 +- 0.0001", "padMax ~ 1.5556 +- 0.0001"] },

    // The mouse: 20 counts right in each of 4 frames.
    { "label": "the mouse slider's middle", "cmd": "asr.look", "mouse": 0.03, "expect": "mouseScale ~ 1 +- 0.001" },
    { "label": "Skyrim's console reads the same value", "cmd": "console", "command": "getini \"fMouseHeadingSensitivity:Controls\"", "expect": "output.0 contains 0.03" },
    { "cmd": "asr.look", "mark": true },
    { "label": "80 counts right", "cmd": "mouse", "dx": 20, "dy": 0, "frames": 4 },
    { "cmd": "wait", "seconds": 0.5 },
    { "label": "CJ's camera turned right", "cmd": "asr.look", "keep": "mouse-middle", "expect": "turned > 5" },
    { "label": "the mouse slider's bottom", "cmd": "asr.look", "mouse": 0.01, "expect": "mouseScale ~ 0.25 +- 0.001" },
    { "cmd": "asr.look", "mark": true },
    { "cmd": "mouse", "dx": 20, "dy": 0, "frames": 4 },
    { "cmd": "wait", "seconds": 0.5 },
    { "label": "a quarter of the middle's turn", "cmd": "asr.look", "vs": "mouse-middle", "expect": "vs ~ 0.25 +- 0.0375" },
    { "label": "the mouse slider's top", "cmd": "asr.look", "mouse": 0.05, "expect": "mouseScale ~ 4 +- 0.001" },
    { "cmd": "asr.look", "mark": true },
    { "cmd": "mouse", "dx": 20, "dy": 0, "frames": 4 },
    { "cmd": "wait", "seconds": 0.5 },
    { "label": "four times the middle's turn", "cmd": "asr.look", "vs": "mouse-middle", "expect": "vs ~ 4 +- 0.6" },
    { "label": "the mouse at its middle again", "cmd": "asr.look", "mouse": 0.03 },

    // The pad's right stick: half right for 0.4 s (full right turns the middle about 175 degrees in that time).
    { "label": "the pad slider's middle", "cmd": "asr.look", "pad": 1.0, "expect": "padScale ~ 1 +- 0.001" },
    { "cmd": "asr.look", "mark": true },
    { "label": "the right stick half right 0.4 s", "cmd": "stick", "side": "right", "x": 0.5, "y": 0, "seconds": 0.4 },
    { "cmd": "wait", "seconds": 0.5 },
    { "label": "CJ's camera turned right", "cmd": "asr.look", "keep": "pad-middle", "expect": "turned > 5" },
    { "label": "the pad slider's bottom", "cmd": "asr.look", "pad": 0.4445, "expect": "padScale ~ 0.25 +- 0.001" },
    { "cmd": "asr.look", "mark": true },
    { "cmd": "stick", "side": "right", "x": 0.5, "y": 0, "seconds": 0.4 },
    { "cmd": "wait", "seconds": 0.5 },
    { "label": "a quarter of the middle's turn", "cmd": "asr.look", "vs": "pad-middle", "expect": "vs ~ 0.25 +- 0.05" },
    { "label": "the pad slider's top", "cmd": "asr.look", "pad": 1.5556, "expect": "padScale ~ 4 +- 0.001" },
    { "cmd": "asr.look", "mark": true },
    { "cmd": "stick", "side": "right", "x": 0.5, "y": 0, "seconds": 0.4 },
    { "cmd": "wait", "seconds": 0.5 },
    { "label": "four times the middle's turn", "cmd": "asr.look", "vs": "pad-middle", "expect": "vs ~ 4 +- 0.8" },

    // The one-time move to the middle, as at a first start, from Skyrim's own defaults.
    { "label": "Skyrim's defaults, near the bottoms", "cmd": "asr.look", "mouse": 0.0125, "pad": 0.6667,
      "expect": ["mouseScale < 0.35", "padScale < 0.5"] },
    { "label": "the move to the middle", "cmd": "asr.look", "reset": true,
      "expect": ["mouse ~ 0.03 +- 0.0001", "pad ~ 1 +- 0.001", "mouseScale ~ 1 +- 0.001", "padScale ~ 1 +- 0.001", "lookReset == 1"] },
    { "label": "logged for both", "cmd": "log", "lines": 5, "match": "look sensitivity moved once to its slider's middle", "expect": "lines.length >= 2" },
    { "label": "and recorded", "cmd": "log", "lines": 1, "match": "recorded \\[Input\\] LookReset=1", "expect": "lines.length == 1" },
    { "label": "Skyrim's console reads the middle", "cmd": "console", "command": "getini \"fGamepadHeadingSensitivity:Controls\"", "expect": "output.0 contains 1.0" }
  ]
}
