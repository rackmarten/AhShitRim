// The vehicles' headlights and tail lights (v36): CJ in a ZR-350 on Riverwood's road at 23:00, checked against what the
// operator saw at night (lamps that didn't look lit, tail lights casting almost nothing, brake lights that never came
// on). Its four lamps burn, each with its corona; its two scene lights are among the renderer's. Then pairs of shots,
// each one with the lamps as San Andreas has them and one with asr.lamps off (or braking against not braking), taken
// at 23:00 with the clock nearly still (timescale 1), the sky clear (fw 81a) and the car standing, a few frames apart (unpaused: the lamps are drawn by the
// frame), compared region by region: the tail lamps glow (lens and halo) and each lights the road behind it red; braking
// makes them and that red patch brighter; the headlights glow white and light the road ahead. The real brake comes
// after: CJ drives off and brakes, and San Andreas says so. By day the lamps are out; blown up, they're out too. Last,
// after a trip into an interior and back (Riverwood's inn), a new ZR-350's lights must still be among the renderer's.
// scripts/skytest.ps1 run scenarios/vehicle-lights.json (scenarios/README.md); vehicle-lights-sandking.json does the
// Sandking. Needs the headlights (protocol v36; until they are on main, scenarios/README.md says how to run it).
//
// The limits (luma, 0 to 255) mean "clearly visible" in the shots at 1280x720, each about half of what the run of 13
// November 2026 measured, where the PNGs showed white headlight glass with a halo, red coronas and a red patch on the road
// behind, and the road ahead lit: tail lenses 122 darker with the lamps off (red 176), their halos 22, the road behind
// each lamp 19 and 21 (red 47 and 51); braking, the halos 4.5 brighter and the road behind 19 and 25 (red 45 and 60); the
// headlight glass 229 luma lit, 192 darker off, its halo 34; the road ahead 31 and 34. The ground beside the car changes
// by 2 or 3 either way (the eye adaptation following the lamps).
{
  "name": "vehicle-lights",
  "steps": [
    { "label": "to Riverwood", "cmd": "console", "command": "coc Riverwood" },
    { "cmd": "wait", "seconds": 8 },
    { "label": "Skyrim's player healthy", "cmd": "console", "command": "player.restoreav health 10000" },
    { "label": "in Riverwood", "cmd": "state", "ref": "player", "expect": ["cell == Riverwood", "dead == false"] },
    { "label": "Skyrim takes the player", "cmd": "asr.cj", "on": false, "expect": "cj == false" },
    { "label": "CJ takes it there", "cmd": "asr.cj", "expect": "cj == true" },
    { "label": "the lamps as San Andreas has them (a run that stopped halfway may have left them off)", "cmd": "asr.lamps", "state": "on" },
    { "label": "night (23:00), the clock nearly still, the sky clear: set through the game, not held by scene (another client's scene restore can't undo it)", "cmd": "asr.night", "hour": 23 },
    { "cmd": "console", "command": "set timescale to 1" },
    { "cmd": "console", "command": "fw 81a" },
    "wait frames=45",
    { "label": "CJ in a ZR-350, its engine running", "cmd": "asr.spawn", "model": 477, "in": true, "expect": ["driven == true", "health > 0"] },
    { "label": "San Andreas lights its lamps", "cmd": "wait", "seconds": 2 },

    { "label": "at night all four lamps burn, both lights on and among the renderer's", "cmd": "probe", "kind": "lights", "at": "asr.vehicle:", "radius": 1500,
      "expect": ["at.details.lamps.litCount == 4", "at.details.wrecked == false", "at.details.lights.length == 2",
                 "at.details.lights.0.fade > 0", "at.details.lights.1.fade > 0", "lights.0.on == true", "lights.1.on == true"] },
    { "label": "the lamps' meshes glow", "cmd": "probe", "kind": "effects", "at": "asr.vehicle:", "radius": 5,
      "expect": ["shaderCount >= 4", "shaders.0.strength > 0"] },

    { "label": "the tail lights: from behind", "cmd": "camera", "mode": "orbit", "at": "asr.vehicle:", "yaw": 0, "distance": 600, "pitch": 15 },
    "wait frames=20",
    { "cmd": "screenshot", "name": "tail-on" },
    { "label": "lamps off", "cmd": "asr.lamps", "state": "off" },
    "wait frames=5",
    { "label": "off, no glow and no light", "cmd": "probe", "kind": "lights", "at": "asr.vehicle:", "radius": 1500,
      "expect": ["at.details.lamps.forcedOff == true", "at.details.lights.0.fade == 0", "at.details.lights.1.fade == 0"] },
    { "cmd": "screenshot", "name": "tail-off" },
    { "label": "lamps as San Andreas has them", "cmd": "asr.lamps", "state": "on" },
    { "label": "the tail lamps glow red, with a halo, and each lights the road behind it red", "cmd": "compare", "a": "tail-on", "b": "tail-off",
      "regions": [ { "name": "lensLeft", "at": "asr.lamp:rearLeft", "worldRadius": 15 },
                   { "name": "lensRight", "at": "asr.lamp:rearRight", "worldRadius": 15 },
                   { "name": "haloLeft", "at": "asr.lamp:rearLeft", "worldRadius": 45 },
                   { "name": "haloRight", "at": "asr.lamp:rearRight", "worldRadius": 45 },
                   { "name": "roadBehindLeft", "at": "asr.lamp:rearLeft", "offset": "-120,0,-65", "worldRadius": 40 },
                   { "name": "roadBehindRight", "at": "asr.lamp:rearRight", "offset": "-120,0,-65", "worldRadius": 40 },
                   { "name": "groundBeside", "at": "asr.vehicle:", "offset": "0,500,-58", "worldRadius": 100 } ],
      "expect": ["regions.0.delta < -60", "regions.1.delta < -60", "regions.0.color.r < -80", "regions.1.color.r < -80",
                 "regions.2.delta < -10", "regions.3.delta < -10",
                 "regions.4.delta < -9", "regions.5.delta < -9", "regions.4.color.r < -20", "regions.5.color.r < -20",
                 "regions.6.delta > -5", "regions.6.delta < 5"] },

    { "label": "not braking", "cmd": "asr.lamps", "state": "nobrake" },
    "wait frames=5",
    { "cmd": "screenshot", "name": "brake-off" },
    { "label": "braking", "cmd": "asr.lamps", "state": "brake" },
    "wait frames=5",
    { "label": "the tail lights brighter and larger", "cmd": "probe", "kind": "lights", "at": "asr.vehicle:", "radius": 1500,
      "expect": ["at.details.lamps.forcedBraking == true", "at.details.lights.1.fade > 5"] },
    { "cmd": "screenshot", "name": "brake-on" },
    { "label": "lamps as San Andreas has them", "cmd": "asr.lamps", "state": "on" },
    { "label": "braking, the tail lamps glow brighter and light more of the road behind", "cmd": "compare", "a": "brake-off", "b": "brake-on",
      "regions": [ { "name": "haloLeft", "at": "asr.lamp:rearLeft", "worldRadius": 45 },
                   { "name": "haloRight", "at": "asr.lamp:rearRight", "worldRadius": 45 },
                   { "name": "roadBehindLeft", "at": "asr.lamp:rearLeft", "offset": "-120,0,-65", "worldRadius": 40 },
                   { "name": "roadBehindRight", "at": "asr.lamp:rearRight", "offset": "-120,0,-65", "worldRadius": 40 },
                   { "name": "groundBeside", "at": "asr.vehicle:", "offset": "0,500,-58", "worldRadius": 100 } ],
      "expect": ["regions.0.delta > 2", "regions.1.delta > 2", "regions.2.delta > 9", "regions.3.delta > 9",
                 "regions.2.color.r > 20", "regions.3.color.r > 20", "regions.4.delta < 5", "regions.4.delta > -5"] },

    { "label": "the road ahead: from behind and above", "cmd": "camera", "mode": "orbit", "at": "asr.vehicle:", "yaw": 0, "distance": 900, "pitch": 35 },
    "wait frames=20",
    { "cmd": "screenshot", "name": "road-on" },
    { "label": "the headlights: from the front", "cmd": "camera", "mode": "orbit", "at": "asr.vehicle:", "yaw": 180, "distance": 500, "pitch": 10, "near": 250 },
    "wait frames=20",
    { "cmd": "screenshot", "name": "front-on" },
    { "label": "the headlight glass glows white", "cmd": "pixels", "shot": "front-on",
      "regions": [ { "name": "lampLeft", "at": "asr.lamp:frontLeft", "worldRadius": 12 }, { "name": "lampRight", "at": "asr.lamp:frontRight", "worldRadius": 12 } ],
      "expect": ["regions.0.luma > 200", "regions.1.luma > 200"] },
    { "label": "lamps off", "cmd": "asr.lamps", "state": "off" },
    "wait frames=5",
    { "cmd": "screenshot", "name": "front-off" },
    { "cmd": "camera", "mode": "orbit", "at": "asr.vehicle:", "yaw": 0, "distance": 900, "pitch": 35 },
    "wait frames=20",
    { "cmd": "screenshot", "name": "road-off" },
    { "label": "lamps as San Andreas has them", "cmd": "asr.lamps", "state": "on" },
    { "cmd": "camera", "mode": "player" },
    { "label": "the headlights light the road ahead", "cmd": "compare", "a": "road-on", "b": "road-off",
      "regions": [ { "name": "near", "at": "asr.vehicle:", "offset": "350,0,-58", "worldRadius": 100 },
                   { "name": "mid", "at": "asr.vehicle:", "offset": "650,0,-58", "worldRadius": 150 },
                   { "name": "groundBeside", "at": "asr.vehicle:", "offset": "0,500,-58", "worldRadius": 100 } ],
      "expect": ["regions.0.delta < -15", "regions.1.delta < -15", "regions.2.delta > -4"] },
    { "label": "the front lamps glow, with a halo", "cmd": "compare", "a": "front-on", "b": "front-off",
      "regions": [ { "name": "lampLeft", "at": "asr.lamp:frontLeft", "worldRadius": 15 },
                   { "name": "lampRight", "at": "asr.lamp:frontRight", "worldRadius": 15 },
                   { "name": "haloLeft", "at": "asr.lamp:frontLeft", "worldRadius": 50 },
                   { "name": "haloRight", "at": "asr.lamp:frontRight", "worldRadius": 50 } ],
      "expect": ["regions.0.delta < -90", "regions.1.delta < -90", "regions.2.delta < -15", "regions.3.delta < -15"] },

    { "label": "CJ drives off (a second, clear of the rocks ahead)", "cmd": "asr.pedals", "gas": true },
    { "cmd": "wait", "seconds": 1 },
    { "label": "and brakes", "cmd": "asr.pedals", "brake": true },
    { "label": "San Andreas says he brakes before the car stops", "cmd": "wait", "until": "at.details.lamps.braking == true",
      "for": { "cmd": "probe", "kind": "lights", "at": "asr.vehicle:", "radius": 1500 }, "timeout": 1.5 },
    { "label": "the tail lights burn for it", "cmd": "probe", "kind": "lights", "at": "asr.vehicle:", "radius": 1500,
      "expect": ["at.details.lights.1.fade > 5"] },
    { "cmd": "screenshot", "name": "braking", "camera": "orbit asr.vehicle: yaw=0 distance=600 pitch=15" },
    { "label": "foot off the pedals", "cmd": "asr.pedals" },
    { "cmd": "wait", "seconds": 2 },

    { "label": "noon", "cmd": "asr.night", "hour": 12 },
    "wait frames=60",
    { "label": "San Andreas switches them off", "cmd": "wait", "seconds": 2 },
    { "label": "by day no lamp burns, both lights out", "cmd": "probe", "kind": "lights", "at": "asr.vehicle:", "radius": 1500,
      "expect": ["at.details.lamps.litCount == 0", "at.details.lights.0.fade == 0", "at.details.lights.1.fade == 0"] },
    { "cmd": "screenshot", "name": "day-behind", "camera": "orbit asr.vehicle: yaw=0 distance=600 pitch=15" },

    { "label": "night again", "cmd": "asr.night", "hour": 23 },
    "wait frames=60",
    { "cmd": "wait", "seconds": 2 },
    { "label": "lit again", "cmd": "probe", "kind": "lights", "at": "asr.vehicle:", "radius": 1500, "expect": "at.details.lamps.litCount == 4" },
    { "label": "CJ gets out", "cmd": "asr.exit" },
    { "label": "the engine runs on: still lit", "cmd": "probe", "kind": "lights", "at": "asr.vehicle:", "radius": 1500, "expect": "at.details.lamps.litCount == 4" },
    { "label": "CJ runs well clear of it", "cmd": "asr.walk", "points": "16700,-47150; 16100,-47050", "gait": "sprint" },
    { "label": "every vehicle blows up", "cmd": "asr.cheat", "code": "CPKTNWT" },
    { "cmd": "wait", "seconds": 4 },
    { "label": "the wreck shows no lamp and no light", "cmd": "probe", "kind": "lights", "at": "asr.vehicle:", "radius": 1500,
      "expect": ["at.details.wrecked == true", "at.details.lamps.litCount == 0", "at.details.lights.0.fade == 0", "at.details.lights.1.fade == 0"] },
    { "cmd": "screenshot", "name": "wreck-behind", "camera": "orbit asr.vehicle: yaw=0 distance=600 pitch=15" },
    { "label": "CJ came through (not Wasted to a temple)", "cmd": "state", "ref": "player", "expect": ["interior == false", "dead == false"] },

    { "label": "into the inn", "cmd": "console", "command": "coc RiverwoodSleepingGiantInn" },
    { "cmd": "wait", "seconds": 6 },
    { "label": "and out to the road", "cmd": "console", "command": "coc Riverwood" },
    { "cmd": "wait", "seconds": 8 },
    { "label": "Skyrim takes the player", "cmd": "asr.cj", "on": false, "expect": "cj == false" },
    { "label": "CJ takes it there", "cmd": "asr.cj", "expect": "cj == true" },
    { "label": "night (23:00), the clock nearly still, the sky clear: set through the game, not held by scene (another client's scene restore can't undo it)", "cmd": "asr.night", "hour": 23 },
    { "cmd": "console", "command": "set timescale to 1" },
    { "cmd": "console", "command": "fw 81a" },
    "wait frames=45",
    { "label": "CJ in another ZR-350", "cmd": "asr.spawn", "model": 477, "in": true, "expect": ["driven == true", "health > 0"] },
    { "cmd": "wait", "seconds": 2 },
    { "cmd": "camera", "mode": "orbit", "at": "asr.vehicle:", "yaw": 0, "distance": 600, "pitch": 15 },
    "wait frames=30",
    { "label": "after an interior its lights still light the scene", "cmd": "probe", "kind": "lights", "at": "asr.vehicle:", "radius": 1500,
      "expect": ["at.details.lamps.litCount == 4", "lights.0.on == true", "lights.1.on == true"] },
    { "cmd": "screenshot", "name": "after-interior-behind" },
    { "cmd": "camera", "mode": "player" },
    { "label": "the clock running again", "cmd": "console", "command": "set timescale to 20" }
  ]
}
