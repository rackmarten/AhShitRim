// A bicycle has no lamps (the operator saw a BMX's back light up red as CJ braked, by day): CJ on each of San Andreas's
// three, the BMX, the Bike and the Mountain Bike, on Riverwood's road at 23:00, standing, riding and braking, no lamp burns
// and no light of ours is there. A Sanchez the same way first, whose two lamps burn and whose tail light brakes, so the
// night and the brake are known to work. Their models do have light dummies (the probe's details: frontDummy, rearDummy).
// scripts/skytest.ps1 run scenarios/vehicle-lights-bicycle.json (scenarios/README.md). Needs the headlights (v36).
{
  "name": "vehicle-lights-bicycle",
  "steps": [
    { "label": "to Riverwood", "cmd": "console", "command": "coc Riverwood" },
    { "cmd": "wait", "seconds": 8 },
    { "label": "Skyrim's player healthy", "cmd": "console", "command": "player.restoreav health 10000" },
    { "label": "Skyrim takes the player", "cmd": "asr.cj", "on": false, "expect": "cj == false" },
    { "label": "CJ takes it there", "cmd": "asr.cj", "expect": "cj == true" },
    { "label": "the lamps as San Andreas has them", "cmd": "asr.lamps", "state": "on" },
    { "label": "night (23:00), the clock nearly still, the sky clear", "cmd": "asr.night", "hour": 23 },
    { "cmd": "console", "command": "set timescale to 1" },
    { "cmd": "console", "command": "fw 81a" },
    "wait frames=45",

    { "label": "CJ on a Sanchez, its engine running", "cmd": "asr.spawn", "model": 468, "in": true, "expect": ["driven == true", "health > 0"] },
    { "cmd": "wait", "seconds": 2 },
    { "label": "the Sanchez's headlight and tail light burn", "cmd": "probe", "kind": "lights", "at": "asr.vehicle:", "radius": 1500,
      "expect": ["at.details.lamps.litCount == 2", "at.details.lamps.braking == false"] },
    { "label": "CJ rides off", "cmd": "asr.pedals", "gas": true },
    { "cmd": "wait", "seconds": 0.8 },
    { "label": "and brakes", "cmd": "asr.pedals", "brake": true },
    { "label": "the Sanchez's tail light brakes", "cmd": "wait", "until": "at.details.lamps.braking == true",
      "for": { "cmd": "probe", "kind": "lights", "at": "asr.vehicle:", "radius": 1500 }, "timeout": 1.5 },
    { "label": "foot off the pedals", "cmd": "asr.pedals" },
    { "cmd": "wait", "seconds": 2 },

    { "label": "back to the road", "cmd": "console", "command": "coc Riverwood" },
    { "cmd": "wait", "seconds": 8 },
    { "label": "CJ on a BMX", "cmd": "asr.spawn", "model": 481, "in": true, "expect": ["driven == true", "health > 0"] },
    { "cmd": "wait", "seconds": 2 },
    { "label": "the BMX standing at night: no lamp burns", "cmd": "probe", "kind": "lights", "at": "asr.vehicle:", "radius": 1500,
      "expect": ["at.details.lamps.litCount == 0", "at.details.lamps.braking == false"] },
    { "cmd": "camera", "mode": "orbit", "at": "asr.vehicle:", "yaw": 0, "distance": 300, "pitch": 10 },
    { "label": "CJ rides off", "cmd": "asr.pedals", "gas": true },
    { "cmd": "wait", "seconds": 1.5 },
    { "label": "the BMX rolling: no lamp burns", "cmd": "probe", "kind": "lights", "at": "asr.vehicle:", "radius": 1500,
      "expect": ["at.details.lamps.litCount == 0", "at.details.lamps.braking == false"] },
    { "label": "and brakes", "cmd": "asr.pedals", "brake": true },
    "wait frames=6",
    { "label": "the BMX braking: no lamp burns", "cmd": "probe", "kind": "lights", "at": "asr.vehicle:", "radius": 1500,
      "expect": ["at.details.lamps.litCount == 0", "at.details.lamps.braking == false"] },
    { "cmd": "screenshot", "name": "bmx-brake" },
    { "label": "foot off the pedals", "cmd": "asr.pedals" },
    { "cmd": "camera", "mode": "player" },

    { "label": "back to the road", "cmd": "console", "command": "coc Riverwood" },
    { "cmd": "wait", "seconds": 8 },
    { "label": "CJ on a Bike", "cmd": "asr.spawn", "model": 509, "in": true, "expect": ["driven == true", "health > 0"] },
    { "cmd": "wait", "seconds": 2 },
    { "label": "the Bike standing at night: no lamp burns", "cmd": "probe", "kind": "lights", "at": "asr.vehicle:", "radius": 1500,
      "expect": ["at.details.lamps.litCount == 0", "at.details.lamps.braking == false"] },
    { "cmd": "camera", "mode": "orbit", "at": "asr.vehicle:", "yaw": 0, "distance": 300, "pitch": 10 },
    { "label": "CJ rides off", "cmd": "asr.pedals", "gas": true },
    { "cmd": "wait", "seconds": 1.5 },
    { "label": "the Bike rolling: no lamp burns", "cmd": "probe", "kind": "lights", "at": "asr.vehicle:", "radius": 1500,
      "expect": ["at.details.lamps.litCount == 0", "at.details.lamps.braking == false"] },
    { "label": "and brakes", "cmd": "asr.pedals", "brake": true },
    "wait frames=6",
    { "label": "the Bike braking: no lamp burns", "cmd": "probe", "kind": "lights", "at": "asr.vehicle:", "radius": 1500,
      "expect": ["at.details.lamps.litCount == 0", "at.details.lamps.braking == false"] },
    { "cmd": "screenshot", "name": "bike-brake" },
    { "label": "foot off the pedals", "cmd": "asr.pedals" },
    { "cmd": "camera", "mode": "player" },

    { "label": "back to the road", "cmd": "console", "command": "coc Riverwood" },
    { "cmd": "wait", "seconds": 8 },
    { "label": "CJ on a Mountain Bike", "cmd": "asr.spawn", "model": 510, "in": true, "expect": ["driven == true", "health > 0"] },
    { "cmd": "wait", "seconds": 2 },
    { "label": "the Mountain Bike standing at night: no lamp burns", "cmd": "probe", "kind": "lights", "at": "asr.vehicle:", "radius": 1500,
      "expect": ["at.details.lamps.litCount == 0", "at.details.lamps.braking == false"] },
    { "cmd": "camera", "mode": "orbit", "at": "asr.vehicle:", "yaw": 0, "distance": 300, "pitch": 10 },
    { "label": "CJ rides off", "cmd": "asr.pedals", "gas": true },
    { "cmd": "wait", "seconds": 1.5 },
    { "label": "the Mountain Bike rolling: no lamp burns", "cmd": "probe", "kind": "lights", "at": "asr.vehicle:", "radius": 1500,
      "expect": ["at.details.lamps.litCount == 0", "at.details.lamps.braking == false"] },
    { "label": "and brakes", "cmd": "asr.pedals", "brake": true },
    "wait frames=6",
    { "label": "the Mountain Bike braking: no lamp burns", "cmd": "probe", "kind": "lights", "at": "asr.vehicle:", "radius": 1500,
      "expect": ["at.details.lamps.litCount == 0", "at.details.lamps.braking == false"] },
    { "cmd": "screenshot", "name": "mtbike-brake" },
    { "label": "foot off the pedals", "cmd": "asr.pedals" },
    { "cmd": "camera", "mode": "player" },

    { "label": "the clock running again", "cmd": "console", "command": "set timescale to 20" }
  ]
}
