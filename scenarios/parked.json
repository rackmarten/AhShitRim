// Parked vehicles (v36, protocol/cpp/parked.h): only bicycles, motorbikes and the quad wait parked. In Riverwood a BMX
// turns up by the road once CJ is there (the feature works on this build), and on the road below Fort Greymoor, where
// round 2's Rhino stood and blocked it, nothing does. scripts/skytest.ps1 run scenarios/parked.json
// (scenarios/README.md). San Andreas's log says what it parked ("vehicle: BMX (481) parked at spot 20 (Riverwood)").
//
// The limits: within 50 m of Riverwood's marker (the BMX's spot is 11 m from it) at least one vehicle 12 s after the
// handover (the BMX; nothing else is there); within 160 m (the drop radius) of the old Rhino spot none, 12 s after.
{
  "name": "parked",
  "steps": [
    { "label": "to Riverwood", "cmd": "console", "command": "coc Riverwood" },
    { "cmd": "wait", "seconds": 8 },
    { "label": "Skyrim's player healthy", "cmd": "console", "command": "player.restoreav health 10000" },
    { "label": "in Riverwood", "cmd": "state", "ref": "player", "expect": ["cell == Riverwood", "dead == false"] },
    { "label": "Skyrim takes the player", "cmd": "asr.cj", "on": false, "expect": "cj == false" },
    { "label": "into the village, by the Sleeping Giant Inn (coc puts the player on the Helgen road, 90 m off)", "cmd": "console", "command": "player.setpos x 22243" },
    { "cmd": "console", "command": "player.setpos y -44616" },
    { "cmd": "console", "command": "player.setpos z 0" },
    { "cmd": "wait", "seconds": 4 },
    { "label": "CJ takes it there", "cmd": "asr.cj", "expect": "cj == true" },
    { "label": "San Andreas parks Riverwood's BMX", "cmd": "wait", "seconds": 12 },
    { "label": "a vehicle parked within 50 m (the BMX)", "cmd": "asr.vehicles", "within": 3500, "expect": ["count >= 1"] },
    { "label": "from above", "cmd": "camera", "mode": "top", "at": "player", "distance": 2500 },
    "wait frames=10",
    { "cmd": "screenshot", "name": "riverwood" },
    { "label": "the game's camera", "cmd": "camera", "mode": "player" },

    { "label": "Skyrim takes the player", "cmd": "asr.cj", "on": false, "expect": "cj == false" },
    { "label": "to the road below Fort Greymoor, round 2's Rhino spot", "cmd": "console", "command": "player.setpos x -9654" },
    { "cmd": "console", "command": "player.setpos y -4901" },
    { "cmd": "console", "command": "player.setpos z -6000" },
    { "cmd": "wait", "seconds": 4 },
    { "label": "CJ takes it there", "cmd": "asr.cj", "expect": "cj == true" },
    { "label": "as long as Riverwood's BMX took", "cmd": "wait", "seconds": 12 },
    { "label": "nothing parked within 160 m", "cmd": "asr.vehicles", "within": 11200, "expect": ["count == 0"] },
    { "label": "from above", "cmd": "camera", "mode": "top", "at": "player", "distance": 4000 },
    "wait frames=10",
    { "cmd": "screenshot", "name": "fort-greymoor" },
    { "label": "the game's camera", "cmd": "camera", "mode": "player" }
  ]
}
