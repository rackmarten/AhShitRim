    {"cmd": "scene", "presets": "day clear"},
    "wait seconds=10",
    {"cmd": "asr.vehicles", "label": "Whiterun stables 10 s: whole, upright, on the ground", "expect": ["count >= 1", "vehicles.0.wrecked == false", "vehicles.0.burning == false", "vehicles.0.smoking == false", "vehicles.0.health > 990", "vehicles.0.up > 0.9", "vehicles.0.above >= -15", "vehicles.0.above <= 25"]},
    {"cmd": "screenshot", "name": "Whiterun-stables-10-s", "camera": "orbit asr.vehicle:0 yaw=90 distance=400 pitch=20"},
    "wait seconds=20",
