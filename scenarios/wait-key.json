// The wait key while CJ has the player: T is a letter of the cheat codes there, so / opens Skyrim's wait menu instead.
// Keys go through Skyrim's own input (asr.key: its input device manager's events, as the keyboard sends them), so
// Skyrim's menu open handler and AhShitRim's input sink both see them. Skyrim refuses to wait "in the air", asking the
// hidden player's character controller, which rarely finds the ground under CJ (protocol/cpp/standing.h): the menu must
// open wherever CJ stands, so it's tried on Riverwood's road, the road below the Whiterun stables, its yard after a
// walk, the slope by the cliff, the grass by the river bridge west of it and after getting off a bike. asr.key's
// "wait" says what the controller was before / stood it (wait.midairBefore: Skyrim would have refused). In the air
// after a jump Skyrim still refuses. T doesn't open the menu and still types cheats (WANRLTW, twice); in a vehicle /
// says to get out first. Shots of the menu where the playtest's failed (grass, the river) and of the refusals.
// scripts/skytest.ps1 run scenarios/wait-key.json (scenarios/README.md).
{
  "name": "wait-key",
  "steps": [
    { "label": "to Riverwood", "cmd": "console", "command": "coc Riverwood" },
    { "cmd": "wait", "seconds": 8 },
    { "label": "Skyrim's player healthy", "cmd": "console", "command": "player.restoreav health 10000" },
    { "label": "in Riverwood", "cmd": "state", "ref": "player", "expect": ["cell == Riverwood", "dead == false"] },
    { "label": "Skyrim takes the player", "cmd": "asr.cj", "on": false, "expect": "cj == false" },
    { "label": "CJ takes it there", "cmd": "asr.cj", "expect": "cj == true" },
    { "label": "San Andreas builds CJ's ground", "cmd": "wait", "seconds": 2 },

    { "label": "Riverwood's road: / opens Skyrim's wait menu", "cmd": "asr.key", "keys": "/", "close": false,
      "expect": ["waitMenu == true", "open == true", "cj == true", "wait.standing == true"] },
    { "cmd": "screenshot", "name": "wait-menu", "hud": true },
    // asr.key's own close (an Escape sent through the input device manager doesn't reach the menu).
    { "label": "the menu closed again", "cmd": "asr.key", "keys": "dik:0x58", "frames": 10 },
    { "label": "the menu is gone, CJ still has the player", "cmd": "asr.key", "keys": "dik:0x58", "frames": 5, "close": false, "expect": ["open == false", "cj == true"] },

    { "label": "T doesn't open the wait menu", "cmd": "asr.key", "keys": "T", "expect": ["waitMenu == false", "cj == true"] },
    // Each typing must be followed in the log by the cheat (logged by its other code, FULLCLIP), right after that asr.key
    // request (the kit logs each request). Whether it was on before isn't known, so either way counts. The pattern is
    // written so the log request's own line doesn't match it.
    { "label": "T types cheats: WANRLTW", "cmd": "asr.key", "keys": "WANRLTW", "frames": 5, "expect": "waitMenu == false" },
    { "label": "the cheat right after those keys", "cmd": "log", "lines": 2, "match": "chea[t]s: FULLCLIP|\"cmd\":\"asr\\.ke[y]\"",
      "expect": ["lines.length == 2", "lines.0 contains WANRLTW", "lines.1 matches infinite ammo, no reloading (on|off)"] },
    { "label": "and again, toggling it back", "cmd": "asr.key", "keys": "WANRLTW", "frames": 5, "expect": "waitMenu == false" },
    { "label": "the cheat again right after those keys", "cmd": "log", "lines": 3, "match": "chea[t]s: FULLCLIP|\"cmd\":\"asr\\.ke[y]\"",
      "expect": ["lines.length == 3", "lines.0 matches infinite ammo", "lines.1 contains WANRLTW", "lines.2 matches infinite ammo, no reloading (on|off)"] },

    { "label": "CJ jumps", "cmd": "asr.key", "keys": " ", "frames": 1 },
    { "label": "he's off the ground", "cmd": "wait", "until": "standing == false", "for": "asr.standing", "timeout": 2 },
    { "label": "in the air Skyrim refuses, as it should", "cmd": "asr.key", "keys": "/", "frames": 10,
      "expect": ["waitMenu == false", "wait.standing == false", "help contains in the air"] },
    { "cmd": "screenshot", "name": "wait-in-the-air", "hud": true },
    { "label": "landed", "cmd": "wait", "seconds": 2 },

    { "label": "to the Whiterun stables", "cmd": "console", "command": "cow Tamriel 4 -3" },
    { "cmd": "wait", "seconds": 8 },
    { "label": "Skyrim takes the player", "cmd": "asr.cj", "on": false, "expect": "cj == false" },
    { "label": "onto the road below the stables (cow's spot varies)", "cmd": "console", "command": "player.setpos x 17521" },
    { "cmd": "console", "command": "player.setpos y -11196" },
    { "cmd": "console", "command": "player.setpos z -4690" },
    { "cmd": "wait", "seconds": 2 },
    { "label": "CJ takes it there", "cmd": "asr.cj", "expect": "cj == true" },
    { "label": "San Andreas builds CJ's ground", "cmd": "wait", "seconds": 3 },
    { "label": "the road below the stables", "cmd": "asr.key", "keys": "/", "expect": ["waitMenu == true", "wait.standing == true"] },

    { "label": "a walk into the yard", "cmd": "asr.walk", "points": "18243,-11004; 18508,-10715", "gait": "walk" },
    { "cmd": "wait", "seconds": 1 },
    { "label": "after the walk, in the yard", "cmd": "asr.key", "keys": "/", "expect": ["waitMenu == true", "wait.standing == true"] },
    { "label": "up the slope by the cliff", "cmd": "asr.walk", "points": "18844,-10474; 19145,-10835", "gait": "run" },
    { "cmd": "wait", "seconds": 1 },
    { "label": "on the slope", "cmd": "asr.key", "keys": "/", "expect": ["waitMenu == true", "wait.standing == true"] },
    { "label": "where", "cmd": "state", "ref": "player" },

    { "label": "down the road west to the river bridge", "cmd": "asr.walk", "points": "18844,-10474; 18243,-11004; 17521,-11196; 17521,-13700; 15073,-13541; 12625,-13082", "gait": "sprint" },
    { "label": "off the road, onto the grass by the river", "cmd": "asr.walk", "points": "12625,-12500", "gait": "walk" },
    { "cmd": "wait", "seconds": 1 },
    { "label": "on the grass by the river: / opens the menu", "cmd": "asr.key", "keys": "/", "close": false,
      "expect": ["waitMenu == true", "open == true", "wait.standing == true"] },
    { "cmd": "screenshot", "name": "wait-menu-river", "hud": true },
    { "label": "the menu closed again", "cmd": "asr.key", "keys": "dik:0x58", "frames": 10 },
    { "label": "where", "cmd": "state", "ref": "player" },

    { "label": "CJ on a Sanchez", "cmd": "asr.spawn", "model": 468, "in": true, "expect": "driven == true" },
    { "cmd": "wait", "seconds": 1 },
    { "label": "on the bike, / says to get out first", "cmd": "asr.key", "keys": "/", "frames": 10,
      "expect": ["waitMenu == false", "help contains Get out of the vehicle"] },
    { "cmd": "screenshot", "name": "wait-in-vehicle", "hud": true },
    { "label": "CJ gets off", "cmd": "asr.exit" },
    { "cmd": "wait", "seconds": 1 },
    { "label": "off the bike: / opens the menu", "cmd": "asr.key", "keys": "/", "expect": ["waitMenu == true", "wait.standing == true"] }
  ]
}
