// The wait key while CJ has the player: T is a letter of the cheat codes there, so / opens Skyrim's wait menu instead.
// Keys go through Skyrim's own input (asr.key: its input device manager's events, as the keyboard sends them), so
// Skyrim's menu open handler and AhShitRim's input sink both see them. On foot / opens the wait menu (a shot of it, the
// HUD on); T doesn't, and still types cheats (WANRLTW on and off again); in a vehicle / says to get out first.
// scripts/skytest.ps1 run scenarios/wait-key.json (scenarios/README.md).
{
  "name": "wait-key",
  "steps": [
    { "label": "to Riverwood", "cmd": "console", "command": "coc Riverwood" },
    { "cmd": "wait", "seconds": 8 },
    { "label": "Skyrim's player healthy", "cmd": "console", "command": "player.restoreav health 10000" },
    { "label": "in Riverwood", "cmd": "state", "ref": "player", "expect": ["cell == Riverwood", "dead == false"] },
    { "label": "Skyrim takes the player", "cmd": "asr.cj", "on": false, "expect": "cj == false" },
    { "label": "CJ takes it there", "cmd": "asr.cj", "expect": "cj == true" },
    { "label": "San Andreas builds CJ's ground", "cmd": "wait", "seconds": 2 },

    { "label": "on foot, / opens Skyrim's wait menu", "cmd": "asr.key", "keys": "/", "close": false, "expect": ["waitMenu == true", "open == true", "cj == true"] },
    { "cmd": "screenshot", "name": "wait-menu", "hud": true },
    { "label": "Escape closes it", "cmd": "asr.key", "keys": "dik:0x01", "frames": 10, "close": false },
    { "label": "the menu is gone, CJ still has the player", "cmd": "asr.key", "keys": "dik:0x58", "frames": 5, "close": false, "expect": ["open == false", "cj == true"] },

    { "label": "T doesn't open the wait menu", "cmd": "asr.key", "keys": "T", "expect": ["waitMenu == false", "cj == true"] },
    { "label": "T types cheats: WANRLTW on", "cmd": "asr.key", "keys": "WANRLTW", "frames": 5 },
    { "label": "and off again", "cmd": "asr.key", "keys": "WANRLTW", "frames": 5, "expect": "waitMenu == false" },
    { "label": "both typed, T among the letters (the log names it by its other code, FULLCLIP)", "cmd": "log", "lines": 2, "match": "typed: infinite ammo",
      "expect": ["lines.length == 2", "lines.0 matches \" on\\b\"", "lines.1 matches \" off\\b\""] },

    { "label": "CJ in a Sandking", "cmd": "asr.spawn", "model": 495, "in": true, "expect": "driven == true" },
    { "cmd": "wait", "seconds": 1 },
    { "label": "in a vehicle, / says to get out first", "cmd": "asr.key", "keys": "/", "frames": 10,
      "expect": ["waitMenu == false", "help contains Get out of the vehicle"] },
    { "cmd": "screenshot", "name": "wait-in-vehicle", "hud": true },
    { "label": "CJ gets out", "cmd": "asr.exit" }
  ]
}
